rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ingelogd() { return request.auth != null; }
    function kantoor() { return request.auth != null && (request.auth.token.email == 'kantoor@gereedmelding.app' || request.auth.token.email.matches('.*@delaatbouwbegeleiding\\.nl')); }
    match /planner/{id} { allow read, create, update: if ingelogd(); allow delete: if kantoor(); }
    match /meldingen/{id} { allow read, create, update: if ingelogd(); allow delete: if kantoor(); }
    match /fotos/{id} { allow read, write: if ingelogd(); }
    match /complexen/{id} { allow read: if ingelogd(); allow write: if kantoor(); }
    match /gevels/{id} { allow read: if ingelogd(); allow write: if kantoor(); }
    match /config/{id} { allow read: if ingelogd(); allow write: if kantoor(); }
    match /logboek/{id} { allow read, write: if kantoor(); }
    match /prullenbak/{id} { allow read, write: if kantoor(); }
    match /{document=**} { allow read: if request.auth != null && request.auth.token.email == 'backup@gereedmelding.app'; }
  }
}
